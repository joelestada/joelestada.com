{
  "name": "joel-estada-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio de Joel Estada: una línea de producción en 3D donde cada máquina es un proyecto.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:perf": "PERF_HOOKS=1 next build",
    "start:perf": "next start -p 3100",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:type-scale",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:type-scale": "node scripts/typescale.mjs --check",
    "check:a11y": "node scripts/a11y.mjs",
    "check:repaint": "node scripts/repaint.mjs",
    "check:nav": "node scripts/nav.mjs",
    "measure:perf": "node scripts/perf.mjs",
    "measure:load": "node scripts/load.mjs",
    "measure:type": "node scripts/typescale.mjs",
    "shots": "node scripts/screenshots.mjs",
    "shots:ui": "node scripts/ui.mjs",
    "shots:hover": "node scripts/hover.mjs",
    "shots:station": "node scripts/station.mjs",
    "gen:plates": "node scripts/plates.mjs",
    "gen:og": "node scripts/og.mjs",
    "gen:shots": "node scripts/shotsizes.mjs",
    "gen:icons": "node scripts/icons.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@react-three/fiber": "^9.8.1",
    "@vercel/speed-insights": "^2.0.0",
    "lenis": "^1.3.26",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.182.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
